<div class="detail-search ticket-history">
  <div class="detail-search-header">
    <div class="tabs tabs-wide">
      <div class="tab active js-ticket-history-tab" data-tab-content="Ticket">
        <span class="tab-name"><%- @T('Ticket') %></span>
        <span class="tab-badge js-ticket-history-counter-Ticket">0</span>
      </div>
      <div class="tab js-ticket-history-tab" data-tab-content="User">
        <span class="tab-name"><%- @T('User') %></span>
        <span class="tab-badge js-ticket-history-counter-User">0</span>
      </div>
    </div>
  </div>

  <div class="js-ticket-history-content"></div>
  <div class="js-ticket-history-pager"></div>
</div>
